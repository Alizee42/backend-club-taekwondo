# ============================================================
# Variables d'environnement requises — Backend Club Taekwondo
# Copier ce fichier en .env et remplir les valeurs
# NE JAMAIS commiter le fichier .env
# ============================================================

# --- Base de données PostgreSQL ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=taekwondodb
PGUSER=postgres
PGPASSWORD=changeme

# --- JWT ---
# Générer avec : openssl rand -hex 32
JWT_SECRET=

# --- Email (Gmail SMTP) ---
# Utiliser un App Password Google, pas le mot de passe du compte
EMAIL_USERNAME=votre-email@gmail.com
EMAIL_PASSWORD=
EMAIL_FROM=noreply@club-taekwondo.com

# --- Stripe ---
# Clés disponibles sur https://dashboard.stripe.com/apikeys
STRIPE_API_KEY=sk_live_...
STRIPE_PUBLIC_KEY=pk_live_...
# Secret du webhook Stripe (Developers > Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Bootstrap Super Admin (premier démarrage uniquement) ---
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@club-taekwondo.com
BOOTSTRAP_SUPER_ADMIN_PASSWORD=

# --- Pool de connexions (optionnel, valeurs par défaut recommandées) ---
# DB_POOL_MAX_SIZE=20
# DB_POOL_MIN_IDLE=5

# --- Divers (optionnel) ---
# PORT=8080
# SPRING_FLYWAY_ENABLED=true
# JPA_DDL_AUTO=none
# MAIL_LOG_LEVEL=INFO
# HIBERNATE_SQL_LOG_LEVEL=WARN
